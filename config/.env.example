# Copy to config/.env (gitignored) and fill in. Never commit the real .env.

# ENV: "dev" uses the *_DEV database variables below and DEBUG=true by default.
ENV=dev

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev server port is passed at runtime (python manage.py runserver 8040).
# Port 8040 is this project's (8000 is XAMPP, 8010 dev / 8020 prod are
# ControlPresupuestos_AP).

# Only in production, when reverse-proxied under a prefix (Apache on the
# proxy server: /analisis_ejecutivos/ -> app VM :8040). Blank in dev.
DJANGO_FORCE_SCRIPT_NAME=
# Set to true only once HTTPS is in front of the proxy.
DJANGO_SECURE_COOKIES=false
# Needed once served through the proxy, e.g. http://187.251.203.223:8088
DJANGO_CSRF_TRUSTED_ORIGINS=

# This app's OWN database (on the separate database server) - PROD
EJECUTIVOS_DB_HOST=
EJECUTIVOS_DB_PORT=3306
EJECUTIVOS_DB_USER=
EJECUTIVOS_DB_PASSWORD=
EJECUTIVOS_DB_NAME=

# This app's OWN database - DEV
EJECUTIVOS_DB_HOST_DEV=localhost
EJECUTIVOS_DB_PORT_DEV=3306
EJECUTIVOS_DB_USER_DEV=
EJECUTIVOS_DB_PASSWORD_DEV=
EJECUTIVOS_DB_NAME_DEV=
